{
  "name": "aetheris",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aetheris — a cinematic 3D city builder you can play in the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "audio": "python3 scripts/generate-audio.py"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
